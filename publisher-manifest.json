border-radius:50%}\n  .tl-time{font-size:12px;letter-spacing:.16em;color:var(--brick);display:block;margin-bottom:4px}\n  .tl-item h3{font-size:17px;margin-bottom:4px}\n  .tl-item p{margin:0;font-size:14.5px;color:var(--ink-soft)}\n\n  /* 区块通用 */\n  section{padding:64px 0;border-bottom:1px solid var(--line)}\n  .sec-head{margin-bottom:36px;max-width:44em}\n  .sec-head .kicker{font-size:12px;letter-spacing:.22em;text-transform:uppercase;color:var(--brick);display:block;margin-bottom:10px}\n  .sec-head h2{font-size:clamp(24px,3.4vw,32px)}\n  .sec-head p{margin-top:14px;color:var(--ink-soft);font-size:15px}\n\n  /* 票据卡片 */\n  .ticket{background:#fdf9f1;border:1.5px dashed var(--brick);padding:24px 24px 20px;position:relative}\n  .ticket::after{content:\"\";position:absolute;left:24px;right:24px;top:0;height:0}\n  .ticket .tick-head{display:flex;justify-content:space-between;align-items:baseline;gap:12px;flex-wrap:wrap;padding-bottom:12px;border-bottom:1px dashed var(--line);margin-bottom:14px}\n  .ticket h3{font-size:19px}\n  .ticket .tick-price{font-size:15px;color:var(--brick);font-weight:700}\n  .ticket p{font-size:14.5px;color:var(--ink-soft);margin-bottom:0}\n\n  /* 使用说明 */\n  .steps{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:20px}\n  .steps .ticket{padding:22px 20px 18px}\n  .steps .ticket h3{font-size:16.5px;margin-bottom:10px}\n  .steps .ticket .num{display:block;font-size:13px;letter-spacing:.18em;color:var(--brick);margin-bottom:8px}\n\n  /* 套餐纵向列表 */\n  .plans{margin-top:8px}\n  .plan-row{display:grid;grid-template-columns:190px minmax(0,1fr) 210px;gap:28px;padding:26px 0;border-top:1px solid var(--line);align-items:start}\n  .plan-row:last-child{border-bottom:1px solid var(--line)}\n  .plan-name h3{font-size:20px}\n  .plan-name .badge{display:inline-block;font-size:11.5px;letter-spacing:.14em;color:var(--brick);border:1px dashed var(--brick);padding:1px 8px;margin-top:8px}\n  .plan-name p{font-size:13.5px;color:var(--ink-soft);margin:8px 0 0}\n  .plan-features li{font-size:14.5px;padding-left:18px;position:relative;margin-bottom:6px;color:var(--ink)}\n  .plan-features li::before{content:\"—\";position:absolute;left:0;color:var(--brick)}\n  .plan-price{text-align:right}\n  .plan-price .p{font-size:24px;font-weight:700;display:block}\n  .plan-price .a{font-size:13px;color:var(--ink-soft);display:block;margin-top:4px}\n  .plan-price .cta{display:inline-block;margin-top:14px;font-size:13.5px}\n  .plans-note{margin-top:30px;font-size:13.5px;color:var(--ink-soft);border-left:3px solid var(--brick);padding:4px 0 4px 16px;max-width:52em}\n\n  /* 客户端 */\n  .clients{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:20px}\n  .client-list li{font-size:14.5px;border-bottom:1px dashed var(--line);padding:10px 0;display:flex;justify-content:space-between;gap:16px}\n  .client-list li:last-child{border-bottom:0}\n  .client-list .ctx{color:var(--ink-soft);font-size:13.5px;text-align:right}\n\n  /* FAQ 编号列表 */\n  .faq-group{margin-bottom:38px}\n  .faq-group h3{font-size:14px;letter-spacing:.16em;color:var(--brick);margin-bottom:18px;padding-bottom:8px;border-bottom:1px solid var(--line)}\n  .faq-item{display:grid;grid-template-columns:52px minmax(0,1fr);gap:18px;padding:18px 0;border-bottom:1px dashed var(--line)}\n  .faq-item:last-child{border-bottom:0}\n  .faq-num{font-size:22px;font-weight:700;color:var(--brick);line-height:1.2;font-variant-numeric:tabular-nums}\n  .faq-item h4{font-size:16.5px;margin:0 0 6px}\n  .faq-item p{margin:0;font-size:14.5px;color:var(--ink-soft)}\n\n  /* 页尾 */\n  footer{padding:44px 0 60px;background:var(--paper-2)}\n  .foot-grid{display:grid;grid-template-columns:minmax(0,1.4fr) minmax(0,1fr);gap:36px;align-items:start}\n  footer .brand{font-size:22px;font-weight:700;letter-spacing:.02em}\n  footer p{font-size:14px;color:var(--ink-soft);margin:10px 0 0;max-width:34em}\n  .foot-links{font-size:14px}\n  .foot-links a{display:inline-block;margin:0 18px 8px 0}\n\n  @media (max-width:860px){\n    .hero-grid{grid-template-columns:1fr;gap:36px}\n    .timeline{margin-left:0}\n    .steps{grid-template-columns:1fr}\n    .plan-row{grid-template-columns:1fr;gap:14px}\n    .plan-price{text-align:left}\n    .clients{grid-template-columns:1fr}\n    .foot-grid{grid-template-columns:1fr}\n  }\n  @media (max-width:520px){\n    .hero{padding:40px 0 48px}\n    section{padding:48px 0}\n    .faq-item{grid-template-columns:38px minmax(0,1fr);gap:12px}\n    .ticket{padding:20px 18px 16px}\n  }\n</style><main>\n\n  <header class=\"hero\">\n    <div class=\"wrap\">\n      <div class=\"hero-grid\">\n        <div>\n          <span class=\"hero-label\">Dolphin</span>\n          <h1>Dolphin\n            <span class=\"thin\">先看清单，再决定要不要订。</span>\n          </h1>\n          <p class=\"hero-intro\">这里是 Dolphin 的说明页。我们尽量不用形容词堆砌，而是把事情按顺序列清楚：你要做什么、套餐之间差在哪里、遇到问题去哪里问。看完再决定，不用着急。</p>\n          <nav class=\"hero-jump\" aria-label=\"页面内目录\">\n            <span>页面内跳转</span>\n            <a href=\"#how\">使用说明</a>\n            <a href=\"#plans\">套餐对照</a>\n            <a href=\"#clients\">客户端</a>\n            <a href=\"#faq\">常见问题</a>\n          </nav>\n        </div>\n\n        <div class=\"timeline\" aria-label=\"阅读顺序\">\n          <div class=\"tl-item\">\n            <span class=\"tl-time\">第一步</span>\n            <h3>先确认用量</h3>\n            <p>估一下你一个月大概用掉多少流量，再决定看哪一档。估算不准就往小一档选，后面可以再调整。</p>\n          </div>\n          <div class=\"tl-item\">\n            <span class=\"tl-time\">第二步</span>\n            <h3>数一下设备</h3>\n            <p>手机、平板、电脑各算一台。同时在线数量和套餐绑定，超过上限时会挤掉先登录的那一台。</p>\n          </div>\n          <div class=\"tl-item\">\n            <span class=\"tl-time\">第三步</span>\n            <h3>看线路要求</h3>\n            <p>如果对延迟敏感，优先看旗舰版；只是日常浏览和看片，基础版够用。</p>\n          </div>\n          <div class=\"tl-item\">\n            <span class=\"tl-time\">第四步</span>\n            <h3>装好客户端</h3>\n            <p>按你手上的设备选对应版本，装完先跑一遍连通性，再批量导入其他设备。</p>\n          </div>\n          <div class=\"tl-item\">\n            <span class=\"tl-time\">第五步</span>\n            <h3>留一条反馈路径</h3>\n            <p>出问题先看常见问题清单，找不到答案再走工单。写清楚设备、时间和现象，处理会快一些。</p>\n          </div>\n        </div>\n      </div>\n    </div>\n  </header>\n\n  <section id=\"how\">\n    <div class=\"wrap\">\n      <div class=\"sec-head\">\n        <span class=\"kicker\">How to use</span>\n        <h2>使用说明：三步走完，不用记太多</h2>\n        <p>下面三件事按顺序做完，基本就能正常用了。每一步都不长，但跳步容易在第四步卡住。</p>\n      </div>\n      <div class=\"steps\">\n        <article class=\"ticket\">\n          <span class=\"num\">01</span>\n          <h3>选套餐并完成订阅</h3>\n          <p>对照下面的套餐表，按当月用量和设备数选一档。年付比月付便宜，但建议先用月付跑一个完整周期再转年付。</p>\n        </article>\n        <article class=\"ticket\">\n          <span class=\"num\">02</span>\n          <h3>装客户端并登录</h3>\n          <p>在客户端区块里找到你设备的对应版本，安装后用订阅时登记的账号登录。首次登录会拉取一次配置，等它走完。</p>\n        </article>\n        <article class=\"ticket\">\n          <span class=\"num\">03</span>\n          <h3>逐台加入并验证</h3>\n          <p>先在一台设备上确认能用，再依次加入其余设备。每加一台都试一次，出问题时能马上定位是哪一台。</p>\n        </article>\n      </div>\n    </div>\n  </section>\n\n  <section id=\"plans\">\n    <div class=\"wrap\">\n      <div class=\"sec-head\">\n        <span class=\"kicker\">Plans</span>\n        <h2>套餐对照：三档，逐行看差异</h2>\n        <p>三档之间的差别主要集中在流量、同时在线设备数和线路类型上。价格按月付标注，年付价写在同一行的右侧。</p>\n      </div>\n\n      <div class=\"plans\">\n        <div class=\"plan-row\">\n          <div class=\"plan-name\">\n            <h3>基础版</h3>\n            <p>适合一到两台设备、以浏览和视频为主的日常使用。</p>\n          </div>\n          <ul class=\"plan-features\">\n            <li>每月 100GB 流量</li>\n            <li>支持 3 台设备同时在线</li>\n            <li>解锁基础流媒体</li>\n            <li>普通线路节点池</li>\n          </ul>\n          <div class=\"plan-price\">\n            <span class=\"p\">¥15/月</span>\n            <span class=\"a\">按年付 ¥150/年</span>\n            <a class=\"cta\" href=\"#faq\">订阅前先看问题清单</a>\n          </div>\n        </div>\n\n        <div class=\"plan-row\">\n          <div class=\"plan-name\">\n            <h3>旗舰版</h3>\n            <span class=\"badge\">常用选择</span>\n            <p>设备多一些，或者对延迟比较敏感，就往上走一档。</p>\n          </div>\n          <ul class=\"plan-features\">\n            <li>每月 300GB 流量</li>\n            <li>支持 5 台设备同时在线</li>\n            <li>全节点原生流媒体解锁</li>\n            <li>IPLC 专线游戏加速优化</li>\n            <li>7x24 优先工单支持</li>\n          </ul>\n          <div class=\"plan-price\">\n            <span class=\"p\">¥35/月</span>\n            <span class=\"a\">按年付 ¥350/年</span>\n            <a class=\"cta\" href=\"#faq\">订阅前先看问题清单</a>\n          </div>\n        </div>\n\n        <div class=\"plan-row\">\n          <div class=\"plan-name\">\n            <h3>团队版</h3>\n            <p>多人共用一套订阅，或者需要固定带宽与路由设置。</p>\n          </div>\n          <ul class=\"plan-features\">\n            <li>每月 1000GB 流量</li>\n            <li>支持 20 台设备同时在线</li>\n            <li>VIP 专属高带宽节点</li>\n            <li>支持企业定制路由</li>\n            <li>专属客户经理服务</li>\n          </ul>\n          <div class=\"plan-price\">\n            <span class=\"p\">¥85/月</span>\n            <span class=\"a\">按年付 ¥850/年</span>\n            <a class=\"cta\" href=\"#faq\">订阅前先看问题清单</a>\n          </div>\n        </div>\n      </div>\n\n      <p class=\"plans-note\">价格与权益以上面三行为准。年付按 10 个月计价，折算下来比月付省两个月。用量和人数接近上一档时，直接选上一档更省心，不必卡在边缘。</p>\n    </div>\n  </section>\n\n  <section id=\"clients\">\n    <div class=\"wrap\">\n      <div class=\"sec-head\">\n        <span class=\"kicker\">Clients</span>\n        <h2>客户端：按设备对号入座</h2>\n        <p>客户端在各平台的获取方式不同，下面按设备类型列出对应的安装位置和注意事项。具体安装文件请以购买后页面内的说明为准。</p>\n      </div>\n      <div class=\"clients\">\n        <article class=\"ticket\">\n          <div class=\"tick-head\">\n            <h3>手机与平板</h3>\n            <span class=\"tick-price\">移动端</span>\n          </div>\n          <ul class=\"client-list\">\n            <li><span>iOS / iPadOS</span><span class=\"ctx\">通过 App Store 安装</span></li>\n            <li><span>Android</span><span class=\"ctx\">安装包或应用商店</span></li>\n            <li><span>注意事项</span><span class=\"ctx\">首次登录需联网拉配置</span></li>\n          </ul>\n        </article>\n        <article class=\"ticket\">\n          <div class=\"tick-head\">\n            <h3>电脑端</h3>\n            <span class=\"tick-price\">桌面端</span>\n          </div>\n          <ul class=\"client-list\">\n            <li><span>macOS</span><span class=\"ctx\">安装后授予网络权限</span></li>\n            <li><span>Windows</span><span class=\"ctx\">按系统位数选安装包</span></li>\n            <li><span>Linux</span><span class=\"ctx\">按发行版说明配置</span></li>\n          </ul>\n        </article>\n        <article class=\"ticket\">\n          <div class=\"tick-head\">\n            <h3>路由器与家庭网络</h3>\n            <span class=\"tick-price\">进阶</span>\n          </div>\n          <ul class=\"client-list\">\n            <li><span>支持范围</span><span class=\"ctx\">以路由器固件为准</span></li>\n            <li><span>配置方式</span><span class=\"ctx\">在路由器后台手动填写</span></li>\n            <li><span>建议</span><span class=\"ctx\">先在单机验证再上路由</span></li>\n          </ul>\n        </article>\n        <article class=\"ticket\">\n          <div class=\"tick-head\">\n            <h3>账号与设备管理</h3>\n            <span class=\"tick-price\">通用</span>\n          </div>\n          <ul class=\"client-list\">\n            <li><span>同时在线上限</span><span class=\"ctx\">随套餐不同</span></li>\n            <li><span>换设备</span><span class=\"ctx\">退出旧设备再登录新设备</span></li>\n            <li><span>异常提示</span><span class=\"ctx\">先核对设备数量</span></li>\n          </ul>\n        </article>\n      </div>\n    </div>\n  </section>\n\n  <section id=\"faq\">\n    <div class=\"wrap\">\n      <div class=\"sec-head\">\n        <span class=\"kicker\">FAQ</span>\n        <h2>常见问题：按编号找答案</h2>\n        <p>下面这些问题在订阅前后都会被问到。找不到对应条目时，带着设备信息和现象描述联系支持，会比只说“连不上”有效得多。</p>\n      </div>\n\n      <div class=\"faq-group\">\n        <h3>关于选择</h3>\n        <div class=\"faq-item\">\n          <span class=\"faq-num\">01</span>\n          <div>\n            <h4>我该从哪一档开始？</h4>\n            <p>先估月用量，再数同时要用的设备。一到两台设备、日常浏览和视频，基础版就够；设备到四五台或对延迟敏感，选旗舰版；多人共用或者需要固定带宽，再考虑团队版。</p>\n          </div>\n        </div>\n        <div class=\"faq-item\">\n          <span class=\"faq-num\">02</span>\n          <div>\n            <h4>月付和年付怎么取舍？</h4>\n            <p>年付按 10 个月计价，比按月付省两个月。建议先用月付跑完一个完整周期，确认用量和稳定性都合适，再转年付，避免一次付久了用不上。</p>\n          </div>\n        </div>\n        <div class=\"faq-item\">\n          <span class=\"faq-num\">03</span>\n          <div>\n            <h4>中途想换档位可以吗？</h4>\n            <p>可以在当前周期结束后调整。如果只是临时用量变大，先确认是否真的超了当月额度，再决定要不要升档，别为了几天的峰值多付一整档的钱。</p>\n          </div>\n        </div>\n      </div>\n\n      <div class=\"faq-group\">\n        <h3>关于使用</h3>\n        <div class=\"faq-item\">\n          <span class=\"faq-num\">04</span>\n          <div>\n            <h4>同时在线设备数怎么算？</h4>\n            <p>手机、平板、电脑各算一台，登录即占用一个名额。达到上限后再登录，会挤掉最早登录的那一台。换设备时先在旧设备上退出，比直接登录更稳妥。</p>\n          </div>\n        </div>\n        <div class=\"faq-item\">\n          <span class=\"faq-num\">05</span>\n          <div>\n            <h4>安装后第一步做什么？</h4>\n            <p>先用一台设备登录，等配置拉取完成，再做一次连通性测试。确认这一台正常之后，才逐台加入其他设备。这样出问题时能马上判断是账号问题还是单台设备问题。</p>\n          </div>\n        </div>\n        <div class=\"faq-item\">\n          <span class=\"faq-num\">06</span>\n          <div>\n            <h4>换设备后提示异常怎么办？</h4>\n            <p>先核对当前同时在线的设备数量是否已到套餐上限，再检查旧设备是否还处于登录状态。多数异常提示都源于名额被占，而不是配置出错。</p>\n          </div>\n        </div>\n      </div>\n\n      <div class=\"faq-group\">\n        <h3>关于支持</h3>\n        <div class=\"faq-item\">\n          <span class=\"faq-num\">07</span>\n          <div>\n            <h4>遇到问题应该先做什么？</h4>\n            <p>先看这份清单里的对应条目，大多数设备数量和安装顺序的问题都能在这里解决。仍然没解决，再提交工单，并写清设备型号、系统版本、出现时间和具体现象。</p>\n          </div>\n        </div>\n        <div class=\"faq-item\">\n          <span class=\"faq-num\">08</span>\n          <div>\n            <h4>工单里写什么信息比较有用？</h4>\n            <p>三件事：哪台设备、什么时候开始、看到什么提示。如果能附上你操作到哪一步，处理会更快。只写“用不了”通常需要来回确认好几轮。</p>\n          </div>\n        </div>\n        <div class=\"faq-item\">\n          <span class=\"faq-num\">09</span>\n          <div>\n            <h4>这页面的价格和权益是最终版本吗？</h4>\n            <p>页面上的三档价格和权益按当前列出的内容为准。若后续有调整，会以订阅时页面展示的信息为准，建议下单前再核对一次当行内容。</p>\n          </div>\n        </div>\n      </div>\n    </div>\n  </section>\n\n</main>\n\n<footer>\n  <div class=\"wrap\">\n    <div class=\"foot-grid\">\n      <div>\n        <div class=\"brand\">Dolphin</div>\n        <p>把上网这件事写成清单：先估用量，再数设备，然后一档一档对照着选。不用被形容词推着走。</p>\n      </div>\n      <div class=\"foot-links\">\n        <a href=\"#how\">使用说明</a>\n        <a href=\"#plans\">套餐对照</a>\n        <a href=\"#clients\">客户端</a>\n        <a href=\"#faq\">常见问题</a>\n      </div>\n    </div>\n  </div>\n</footer>",
